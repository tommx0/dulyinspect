{
  "name": "tuerpruefung",
  "private": true,
  "version": "2.90.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:typen": "supabase gen types typescript --local > src/lib/datenbank.types.ts",
    "db:test": "supabase test db",
    "e2e:stack": "node scripts/e2e-stack.mjs",
    "db:seed": "python3 scripts/erzeuge_seed.py",
    "test": "vitest run",
    "anleitung": "playwright test -c anleitung/playwright.config.ts",
    "anleitung:pdf": "playwright test -c anleitung/playwright.config.ts --grep PDF",
    "kunde:einrichten": "node scripts/kunde-einrichten.mjs",
    "ausrollen": "node scripts/ausrollen.mjs",
    "ausrollen:coolify": "node scripts/ausrollen-coolify.mjs",
    "migrationen:signieren": "node scripts/migrationen-signieren.mjs",
    "einrichtung:pdf": "node scripts/einrichtung-pdf.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.48.0",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "signature_pad": "^5.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "pdfjs-dist": "^6.3.289",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
