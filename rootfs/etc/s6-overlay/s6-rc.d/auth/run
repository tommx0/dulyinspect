#!/bin/bash
exec 2>&1
source /usr/local/lib/instance/common.sh
load_secrets
SERVICE_ENV=(
  GOTRUE_DB_DATABASE_URL="postgres://supabase_auth_admin:$PW_AUTH@127.0.0.1:5432/postgres?search_path=auth"
  GOTRUE_DB_MIGRATIONS_PATH=/usr/local/etc/auth/migrations GOTRUE_DB_DRIVER=postgres GOTRUE_DB_MAX_POOL_SIZE=10
  GOTRUE_JWT_SECRET="$JWT_SECRET" API_EXTERNAL_URL="$APP_URL" GOTRUE_SITE_URL="$APP_URL"
  GOTRUE_URI_ALLOW_LIST="$APP_URL/**"
  GOTRUE_API_HOST=127.0.0.1 GOTRUE_API_PORT=9999
  GOTRUE_DISABLE_SIGNUP=true GOTRUE_JWT_ADMIN_ROLES=service_role GOTRUE_JWT_AUD=authenticated
  GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated GOTRUE_JWT_EXP=3600 GOTRUE_EXTERNAL_EMAIL_ENABLED=true
  GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false GOTRUE_MAILER_AUTOCONFIRM=false GOTRUE_EXTERNAL_PHONE_ENABLED=false
  GOTRUE_PASSWORD_MIN_LENGTH=10 GOTRUE_MFA_TOTP_ENROLL_ENABLED=true GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
  GOTRUE_RATE_LIMIT_HEADER=X-Real-IP
)
run_as auth gotrue
