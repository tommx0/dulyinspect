#!/bin/bash
exec 2>&1
source /usr/local/lib/instance/common.sh
load_secrets
SERVICE_ENV=(
  PGRST_DB_URI="postgres://authenticator:$PW_AUTHENTICATOR@127.0.0.1:5432/postgres"
  PGRST_JWT_SECRET="$JWT_SECRET" PGRST_APP_SETTINGS_JWT_SECRET="$JWT_SECRET" PGRST_APP_SETTINGS_JWT_EXP=3600
  PGRST_SERVER_HOST=127.0.0.1 PGRST_SERVER_PORT=3000
  # No API description and no GraphQL, in addition to the block in the router
  PGRST_DB_SCHEMAS=public,storage PGRST_OPENAPI_MODE=disabled PGRST_DB_MAX_ROWS=1000 PGRST_DB_EXTRA_SEARCH_PATH=public
  PGRST_DB_ANON_ROLE=anon PGRST_DB_USE_LEGACY_GUCS=false PGRST_DB_POOL=10
)
run_as rest postgrest
